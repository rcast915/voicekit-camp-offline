# =========================================================================
#  voicekit.service  —  Systemd unit for AI Summer Camp Voice Kit (offline)
#
#  Starts ai_camp_assistant.py at boot.  The assistant waits until the
#  instructor's computer (computer/server.py) is reachable, so the Pi and
#  the computer can be turned on in any order.
#
#  INSTALLATION (run these commands on each Raspberry Pi):
#
#    # 1. Copy the assistant and the student's boot sequence:
#    mkdir -p /home/pi/voicekit-offline
#    cp ai_camp_assistant.py boot_sequence.py /home/pi/voicekit-offline/
#
#    # 2. Copy this file and enable it:
#    sudo cp voicekit.service /etc/systemd/system/voicekit.service
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now voicekit.service
#
#    # 3. Check status / view logs:
#    systemctl status voicekit.service
#    journalctl -u voicekit.service -f
#
#  Restart=on-failure brings the assistant back after a crash.  There are
#  no API costs any more, so restarting is safe.  Saying "goodbye" exits
#  cleanly and does NOT restart — reboot the Pi to start it again.
# =========================================================================

[Unit]
Description=AI Camp Voice Kit Assistant (offline edition)
After=network.target sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/voicekit-offline
ExecStart=/usr/bin/python3 -u /home/pi/voicekit-offline/ai_camp_assistant.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
